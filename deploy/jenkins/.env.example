# Jenkins compose 전용 값 — 실제 값은 NAS의 <JENKINS_DIR>/.env 에만 존재한다 (D28)
# 허브의 deploy/.env 와는 별도 파일이다.

GHCR_OWNER=""            # ghcr 네임스페이스 (소문자)
JENKINS_PORT=""          # 비어 있는 포트. 확인은 반드시 sudo netstat -tlnp
                         #   (sudo 없이는 다른 사용자의 소켓이 안 보여 "비어 있음"이 거짓이 된다)
JENKINS_BIND=""          # 리슨할 인터페이스 주소. 비우면 0.0.0.0(전체) — 권장하지 않는다.
                         #   Tailscale 주소를 넣으면 사설망 밖에서 접근 자체가 불가능해진다.
                         #   docker.sock 위험의 실질적 방어선이다 (설계서 §14-4-2)
JENKINS_HOME_DIR=""      # jenkins_home 보관 경로. Hyper Backup 대상에 포함할 것 (§12-4)
DEPLOY_DIR=""            # 허브 배포 디렉터리. 호스트 경로 그대로 (컨테이너 안에서도 같은 경로로 마운트)
DOCKER_GID=""            # stat -c '%g' /var/run/docker.sock 의 출력값 그대로
                         #   Synology는 사용자 생성 그룹이 65536부터라 값이 커도 정상이다
