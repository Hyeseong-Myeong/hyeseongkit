# hyeseongkit — 환경변수 템플릿
#
# 사용법: 이 파일을 복사해 .env 를 만들고 값을 채운다. .env 는 커밋되지 않는다.
#   - NAS 배포용:  <DEPLOY_DIR>/.env      (docker compose 가 자동으로 읽는다)
#   - 각 기기용:   셸 환경변수 또는 기기 로컬 .env
# 값의 의미와 플레이스홀더 규약은 docs/session_persistence_impl_spec.md §0-3-1, §12-2 참조.
#
# ⚠️ 실제 값(주소·계정·토큰)은 이 파일에 절대 넣지 않는다. 키만 유지한다.

# ── NAS 배포 (compose가 직접 참조) ───────────────────────────
GHCR_OWNER=""                  # 컨테이너 레지스트리 네임스페이스 (소문자)
IMAGE_TAG="latest"             # 배포 태그. 롤백 시 sha-xxxxxxx
GHCR_TOKEN=""                  # 비공개 패키지일 때만 필요 (read:packages)
HK_DOCKER_NET=""               # 기존 CouchDB가 속한 도커 네트워크명

# ── 허브 (NAS) ──────────────────────────────────────────────
HK_COUCHDB_URL=""              # 예: http://<COUCHDB_HOST>:5984  (컨테이너 주소)
HK_COUCHDB_USER=""             # hk_hub — admin 아님 (권한 분리, §12-3)
HK_COUCHDB_PASSWORD=""
HK_COUCHDB_DB="hyeseongkit_sessions"
HK_VAULT_DB="hyeseongkit_vault"
HK_ADMIN_TOKEN=""              # 기기 토큰 발급용. NAS에만 존재 (기기로 반출 금지)
HK_VAULT_OUT="/vault-out"

# ── 클라이언트 (각 기기) ────────────────────────────────────
HK_HUB_URL=""                  # 예: http://<HUB_HOST>:9100
HK_API_TOKEN=""                # 기기 토큰 (§5-2 절차로 발급)
HK_TOKEN_BUDGET="2000"

# ── P6 이후 (요약 — 지금은 비워 둔다) ───────────────────────
HK_SUMMARY_ENDPOINT=""
HK_SUMMARY_MODEL=""
HK_SUMMARY_MODEL_PRIVATE=""
